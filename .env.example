# Copy to .env and fill in. Values already exported in the shell win over these.

# Base URL of the server. The /v1/systemone or /v1/chat/completions path is
# added if missing, and /v1 paths are tolerated.
#   hosted api      https://api.typesafe.ai
#   LiteLLM gateway https://api.ai.kodekloud.com/v1
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Your key. TYPESAFE_API_KEY is the name the SDK and the API expect.
TYPESAFE_API_KEY=

# Must match a model your server serves. Gateways usually namespace it,
# for example typesafe/jev-1.13.0.
JEV_MODEL=jev-1.13.0

# Seconds per request.
JEV_TIMEOUT=30

# Append one JSON record per live decision; "-" writes them to stdout.
JEV_DECISION_LOG=decisions.jsonl